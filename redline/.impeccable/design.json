      "html": "<section class=\"ds-panel\"><h2>Performance curves</h2><p>Power delivery across the rev range</p><div class=\"ds-legend\"><span><i></i>Power (hp)</span><span><i class=\"ds-blue\"></i>Torque (lb-ft)</span></div><p class=\"ds-note\">Calculated illustration, not a measured dyno run.</p></section>",
      "css": ".ds-panel{font-family:'DM Sans',sans-serif;border:1px solid var(--border,#303439);border-radius:var(--radius,12px);background:var(--panel,#1b1e21);padding:23px;color:var(--text,#f2f3f4);max-width:520px}.ds-panel h2{font-size:16px;font-weight:600;letter-spacing:-.02em;margin:0 0 8px}.ds-panel p{color:var(--muted,#a1a8ae);font-size:13px;line-height:1.6;margin:0}.ds-legend{display:flex;gap:18px;flex-wrap:wrap;color:#b5bdc3;font-size:12px;margin-top:18px}.ds-legend span{display:flex;align-items:center;gap:7px}.ds-legend i{width:15px;height:3px;border-radius:2px;background:var(--accent,#ff784a)}.ds-legend .ds-blue{background:var(--blue,#8cacf1)}.ds-panel .ds-note{padding-top:16px;font-size:12px}"
    }
