      "html": "<div class=\"ds-field\"><label for=\"ds-year\">Model year</label><select id=\"ds-year\"><option>2024</option><option>2023</option><option>2022</option></select></div>",
      "css": ".ds-field{font-family:'DM Sans',sans-serif;max-width:300px}.ds-field label{display:block;color:var(--muted,#a1a8ae);font-size:14px;margin-bottom:7px}.ds-field select{width:100%;border:1px solid var(--border,#303439);border-radius:7px;padding:11px 24px 11px 12px;background:var(--panel,#1b1e21);color:var(--text,#f2f3f4);min-height:43px;font:14px \"DM Sans\",sans-serif;color-scheme:dark}.ds-field select:focus-visible{outline:2px solid var(--accent,#ff784a);outline-offset:4px;}"
